# Auto detect text files and perform LF normalization
* text=auto

# Unity YAML
*.unity merge=unityyamlmerge eol=lf
*.prefab merge=unityyamlmerge eol=lf
*.asset merge=unityyamlmerge eol=lf
*.meta merge=unityyamlmerge eol=lf
*.mat merge=unityyamlmerge eol=lf

# C# scripts
*.cs eol=lf

# Shader files
*.shader eol=lf
*.cginc eol=lf

# Compute shaders
*.compute eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.tif binary
*.tiff binary
*.bmp binary
*.exr binary
*.hdr binary

# Audio
*.mp3 binary
*.ogg binary
*.wav binary

# Video
*.mp4 binary
*.mov binary
*.avi binary

# 3D Models
*.fbx binary
*.obj binary
*.blend binary

# Fonts
*.ttf binary
*.otf binary

# Archives
*.zip binary
*.gz binary

# Build files
*.apk binary
*.aab binary
*.app binary
